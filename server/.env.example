PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Exact frontend origin; use your production HTTPS origin after deployment.
FRONTEND_URL=http://localhost:5173
# Generate a long random secret locally. Do not commit your real .env file.
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
# Set true only if the API is behind a trusted HTTPS reverse proxy.
TRUST_PROXY=false
